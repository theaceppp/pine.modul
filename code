    top_on = htf_label_position == 'Both' or htf_label_position == 'Top'
    bottom_on = htf_label_position == 'Both' or htf_label_position == 'Bottom'
    if top_on and not na(top_y) and not na(x)
        if htf_label_show
            f_push_htf_lbl(x, top_y, txt + (htf_timer_show and has_rem ? "\n" : ""), label.style_label_down, label_clr, size.small)
        if htf_timer_show and has_rem
            f_push_htf_lbl(x, top_y, rem, label.style_label_down, htf_timer_color, size.small)
    if bottom_on and not na(bottom_y) and not na(x)
        if htf_label_show
            f_push_htf_lbl(x, bottom_y, (htf_timer_show and has_rem ? "\n" : "") + txt, label.style_label_up, label_clr, size.small)
        if htf_timer_show and has_rem
            f_push_htf_lbl(x, bottom_y, rem, label.style_label_up, htf_timer_color, size.small)
    htf_candles

//==============================================================================
// PSP — single source of truth (dipakai LTF C2 dan HTF pane tag)
//==============================================================================
type PspHit
    string tf
    int o_idx

var array<PspHit> psp_hits = array.new<PspHit>()

f_psp_has(string _tf, int _o_idx) =>
    bool has = false
    if psp_show and psp_hits.size() > 0
        for hit_item in psp_hits
            if hit_item.tf == _tf and hit_item.o_idx == _o_idx
                has := true
                break
    has

// [FIX-C2PSP] Untuk LTF: cari index candle pane yang memuat bar chart c2_bar.
f_psp_c2_pane_index(array<UDT_HTF_Candle> _cs, int _c2_bar) =>
    int found = -1
    if not na(_c2_bar) and _cs.size() > 0
        for [i, cd] in _cs
            if cd.o_idx <= _c2_bar and _c2_bar <= cd.c_idx
                found := i
                break
    found

// [FIX-C2PSP] Spesifikasi label C2 — SATU-SATUNYA tempat menentukan "C2" vs "C2 + PSP"
// untuk LTF label di chart. HTF pane memakai kunci yang sama (raw tf + o_idx candle pane).
f_c2_label_spec(array<UDT_HTF_Candle> _cs, string _raw_tf, int _c2_bar) =>
    int idx = f_psp_c2_pane_index(_cs, _c2_bar)
    bool psp_hit = false
    if idx >= 0
        UDT_HTF_Candle pane_c2 = _cs.get(idx)
        psp_hit := f_psp_has(_raw_tf, pane_c2.o_idx)
    [psp_hit, idx]

// Tag C2 di HTF pane (dipakai bila psp_htf_show aktif — guard di pemanggil).
f_psp_pane_tag(array<UDT_HTF_Candle> _cs, int _c1_index, bool _is_high, HtfPaneCfg _cfg) =>
    if _c1_index >= 1
        UDT_HTF_Candle c2_candle = _cs.get(_c1_index - 1)
        if not na(c2_candle.wick_x) and (c2_candle.is_closed or c2_early_on)
            bool hit = f_psp_has(_cfg.tf, c2_candle.o_idx)
            bool live_early = not c2_candle.is_closed
            bin.bin_lbl.push(label.new(x = c2_candle.wick_x, y = _is_high ? c2_candle.h : c2_candle.l, text = hit ? 'C2 + PSP' : 'C2', xloc = xloc.bar_index, yloc = yloc.price, style = _is_high ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = hit ? psp_color : live_early ? c2_early_color : global_text_color, size = cisd_c2_label_size))
    0

// [FIX-C2PSP-v2] Label C2 di chart LTF: dibuat dari candle C2 + seleksi sweep yang SAMA
// dengan tag HTF pane. Teks/warna memakai f_psp_has dengan kunci (tf, o_idx) yang sama.
// [EQ] index candle C1 untuk C2 TERBARU yang sudah close dan punya sweep valid (C2 terkonfirmasi),
// beserta arah sweep (true = sweep high = setup bearish). Rangkaian C3-C6/EQ hanya dibuat dari C2 ini;
// begitu ada C2 baru terkonfirmasi, rangkaian lama otomatis hilang.
f_newest_c2_c1_index(array<UDT_HTF_Candle> _cs) =>
    int res = na
    bool res_high = false
    for i = 1 to _cs.size() - 1
        UDT_HTF_Candle c2_ref = _cs.get(i - 1)
        if c2_ref.is_closed
            UDT_HTF_Candle c1c = _cs.get(i)
            for sw in c1c.htf_sweeps
                if na(res) and not sw.invalidated and not sw.removed and not sw.invalidate_sweep(c2_ref)
                    res := i
                    res_high := sw.bull
        if not na(res)
            break
    [res, res_high]

// Stage C3..C6 dari C2 terkonfirmasi terbaru, hanya pane HTF1. Stage k = candle HTF1 ke-k.
// Label 'C<k>' (+ ' + PSP' bila candle k punya PSP) tepat di high (sweep high) / low (sweep low) candle k, seperti C2 (LTF),
// dan tag identik di wick candle k pada pane HTF1 (toggle 'HTF Tag' di grup PSP). Tanpa invalidasi XC, tanpa garis EQ.
f_draw_stage_labels(array<UDT_HTF_Candle> _cs, string _tf) =>
    if (c_stage_lbl_show or psp_htf_show) and _cs.size() > 2
        [c1i, c1_high] = f_newest_c2_c1_index(_cs)
        if not na(c1i) and c1i >= 2
            for t = 0 to 3
                bool show_t = t == 0 ? c_eq_s3 : t == 1 ? c_eq_s4 : t == 2 ? c_eq_s5 : c_eq_s6
                int m = c1i - 1 - t
                if show_t and m >= 1
                    UDT_HTF_Candle ck = _cs.get(m)
                    if ck.is_closed
                        UDT_HTF_Candle sc = _cs.get(m - 1)
                        bool s_hit = f_psp_has(_tf, sc.o_idx)
                        string s_txt = 'C' + str.tostring(3 + t) + (s_hit ? ' + PSP' : '')
                        color s_col = s_hit ? psp_color : global_text_color
                        if c_stage_lbl_show
                            int s_x = c1_high ? sc.h_idx : sc.l_idx
                            float s_y = c1_high ? sc.h : sc.l
                            if not na(s_x) and not na(s_y)
                                bin.bin_lbl.push(label.new(x = s_x, y = s_y, text = s_txt, xloc = xloc.bar_index, yloc = yloc.price, style = c1_high ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = s_col, size = cisd_c2_label_size))
                        if psp_htf_show and not na(sc.wick_x)
                            bin.bin_lbl.push(label.new(x = sc.wick_x, y = c1_high ? sc.h : sc.l, text = s_txt, xloc = xloc.bar_index, yloc = yloc.price, style = c1_high ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = s_col, size = cisd_c2_label_size))
    0

f_c2_ltf_label(array<UDT_HTF_Candle> _cs, int _c1_index, bool _is_high, HtfPaneCfg _cfg) =>
    if _c1_index >= 1
        UDT_HTF_Candle c2_candle = _cs.get(_c1_index - 1)
        if cisd_c2_label_show and psp_ltf_show
            int lx = _is_high ? c2_candle.h_idx : c2_candle.l_idx
            float ly = _is_high ? c2_candle.h : c2_candle.l
            if not na(lx) and not na(ly) and (c2_candle.is_closed or c2_early_on)
                bool hit = f_psp_has(_cfg.tf, c2_candle.o_idx)
                bool live_early = not c2_candle.is_closed
                string c2_txt = hit ? 'C2 + PSP' : 'C2'
                color c2_col = hit ? psp_color : live_early ? c2_early_color : global_text_color
                // Pane berbeda (mis. 4H, 7H, 1D) bisa memakai ekstrem yang sama sebagai C2 -> satukan jadi satu label.
                // Jika salah satu pane punya PSP, label yang tampil adalah 'C2 + PSP'.
                bool c2_dup = false
                for ex_lbl in bin.bin_lbl
                    if not c2_dup and label.get_x(ex_lbl) == lx and label.get_y(ex_lbl) == ly and str.startswith(label.get_text(ex_lbl), 'C2')
                        c2_dup := true
                        if hit and label.get_text(ex_lbl) == 'C2'
                            label.set_text(ex_lbl, c2_txt)
                            label.set_textcolor(ex_lbl, c2_col)
                if not c2_dup
                    bin.bin_lbl.push(label.new(x = lx, y = ly, text = c2_txt, xloc = xloc.bar_index, yloc = yloc.price, style = _is_high ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = c2_col, size = cisd_c2_label_size))
    0

f_draw_sweep_set(array<UDT_HTF_Candle> htf_candles, bool ltf, HtfPaneCfg cfg, bool lbl_only) =>
    if cfg.sweep_cap == 1
        for side = 0 to 1
            want_bull = side == 0
            int newest_candle_index = na
            int newest_sweep_index = na
            int newest_event_index = na
            for [i, candle] in htf_candles
                sweep_count = ltf ? array.size(candle.ltf_sweeps) : array.size(candle.htf_sweeps)
                if sweep_count > 0
                    for j = 0 to sweep_count - 1
                        UDT_Sweep sweep = ltf ? array.get(candle.ltf_sweeps, j) : array.get(candle.htf_sweeps, j)
                        if sweep.bull == want_bull
                            c2_inside_c1 = false
                            if i > 0
                                UDT_HTF_Candle c2_ref = array.get(htf_candles, i - 1)
                                c2_inside_c1 := not sweep.invalidate_sweep(c2_ref)
                            valid_c1_sweep = not sweep.invalidated and not sweep.removed and c2_inside_c1
                            if valid_c1_sweep
                                event_index = nz(sweep.cross_idx, nz(sweep.c2_right, sweep.x2))
                                if na(newest_event_index) or event_index > newest_event_index
                                    newest_event_index := event_index
                                    newest_candle_index := i
                                    newest_sweep_index := j
            if not na(newest_candle_index) and not na(newest_sweep_index)
                newest_candle = htf_candles.get(newest_candle_index)
                UDT_Sweep newest_sweep = ltf ? newest_candle.ltf_sweeps.get(newest_sweep_index) : newest_candle.htf_sweeps.get(newest_sweep_index)
                int c3_open_idx = newest_candle_index >= 2 ? htf_candles.get(newest_candle_index - 2).o_idx : na
                if lbl_only
                    f_c2_ltf_label(htf_candles, newest_candle_index, newest_sweep.bull, cfg)
                else
                    newest_sweep.draw_sweep(ltf, cfg, c3_open_idx)
                    // [FIX-C2PSP] HTF pane tag hanya jika psp_htf_show (input) aktif.
                    if not ltf and psp_htf_show
                        f_psp_pane_tag(htf_candles, newest_candle_index, newest_sweep.bull, cfg)
    else
        counted = 0
        for [i, candle] in htf_candles
            sweep_count = ltf ? array.size(candle.ltf_sweeps) : array.size(candle.htf_sweeps)
            if sweep_count > 0
                c2_closed = ltf or (i > 0 and array.get(htf_candles, i - 1).is_closed)
                for j = 0 to sweep_count - 1
                    UDT_Sweep sweep = ltf ? array.get(candle.ltf_sweeps, j) : array.get(candle.htf_sweeps, j)
                    c2_live_valid = true
                    if i > 0
                        UDT_HTF_Candle c2_ref = array.get(htf_candles, i - 1)
                        c2_live_valid := not sweep.invalidate_sweep(c2_ref)
                    if not sweep.invalidated and not sweep.removed and c2_live_valid
                        within_cap = not c2_closed or counted < cfg.sweep_cap
                        if within_cap
                            int c3_open_idx = i >= 2 ? htf_candles.get(i - 2).o_idx : na
                            if lbl_only
                                f_c2_ltf_label(htf_candles, i, sweep.bull, cfg)
                            else
                                sweep.draw_sweep(ltf, cfg, c3_open_idx)
                                // [FIX-C2PSP] guard psp_htf_show
                                if not ltf and psp_htf_show
                                    f_psp_pane_tag(htf_candles, i, sweep.bull, cfg)
                        if c2_closed and within_cap
                            counted += 1
                            if counted >= cfg.sweep_cap
                                break
            if counted >= cfg.sweep_cap
                break
    0
method plot_ltf(array<UDT_HTF_Candle> htf_candles, HtfPaneCfg cfg) =>
    if cfg.ltf_sweeps
        f_draw_sweep_set(htf_candles, true, cfg, false)
    htf_candles
method plot_htf(array<UDT_HTF_Candle> htf_candles, HtfPaneCfg cfg, float shared_label_top, float shared_label_bottom, int close_t, color label_clr, bool src_lbl) =>
    htf_candles.position_htf_sweeps()
    for candle in htf_candles
        if cfg.htf_show and cfg.candle_show
            candle.draw_htf_candle()
    if cfg.htf_show and cfg.htf_sweeps
        f_draw_sweep_set(htf_candles, false, cfg, false)
    if cfg.ltf_sweeps
        htf_candles.plot_ltf(cfg)
    if (htf_label_show or htf_timer_show) and cfg.htf_show
        htf_candles.draw_htf_label(cfg.tf, shared_label_top, shared_label_bottom, close_t, label_clr, src_lbl)
    htf_candles
f_htf_next_offset(array<UDT_HTF_Candle> _candles, int _offset) =>
    _next = _offset
    int _rightmost = na
    for candle in _candles
        if na(_rightmost) or candle.candle_rigth > _rightmost
            _rightmost := candle.candle_rigth
    if not na(_rightmost)
        _next := _rightmost - bar_index + htf_sweeps_distance_between
    _next
f_run_htf_pane(array<UDT_HTF_Candle> _candles, HtfPaneCfg _cfg, int _offset, float _shared_label_top, float _shared_label_bottom, int _close_t, color _label_clr, bool _src_lbl) =>
    _next_offset = _offset
    if _cfg.show
        _candles.position_htf_candles(_offset)
        _candles.plot_htf(_cfg, _shared_label_top, _shared_label_bottom, _close_t, _label_clr, _src_lbl)
        if _cfg.candle_show
            _next_offset := f_htf_next_offset(_candles, _offset)
    _next_offset
f_htf_cfg(_pane, _tf) =>
    _sec = f_htf_seconds(_tf)
    _sync_off = _tf == ''
    _show_input = _pane == 1 ? htf_sweeps_tf_1_show : _pane == 2 ? htf_sweeps_tf_2_show : htf_sweeps_tf_3_show
    _show = _show_input and not _sync_off and not na(_sec) and tf_sec < _sec and (_pane == 1 or tf_sec <= 3600)
    _candle_show = _show
    _ltf_sweeps = htf_sweeps_display != 'HTF Pane Only'
    _htf_sweeps = htf_sweeps_display != 'Main Chart Only'
    _sweep_label = _pane == 1 ? htf_sweep_label_1 : _pane == 2 ? htf_sweep_label_2 : htf_sweep_label_3
    HtfPaneCfg.new(
        _show,
        _candle_show,
        _tf,
        true,
        _ltf_sweeps,
        _htf_sweeps,
        htf_sweep_display_cap,
        true,
        htf_sweep_color,
        _sweep_label
    )
f_update_htf_pane(array<UDT_HTF_Candle> candles, HtfPaneCfg cfg, int count, bool perf_on, bool cisd_internal) =>
    need_visual_htf = perf_on and (cfg.show or cfg.candle_show)
    need_cisd_htf = cisd_internal
    need_htf = need_visual_htf or need_cisd_htf
    if need_htf
        c = candles.detect_htf_candle(true, cfg.tf)
        is_new = not na(c)
        if is_new
            candles.add_htf_candle(c, count)
        need_visual_sweeps = perf_on and cfg.show and (cfg.ltf_sweeps or cfg.htf_sweeps)
        if need_visual_sweeps or need_cisd_htf
            candles.detect_sweeps(is_new)
    candles
f_update_prof_pane(array<UDT_HTF_Candle> candles, HtfPaneCfg cfg, int count, bool perf_on, bool begins) =>
    need_visual = perf_on and (cfg.show or cfg.candle_show)
    if need_visual
        c = candles.detect_prof_candle(true, begins, cfg.tf)
        is_new = not na(c)
        if is_new
            candles.add_htf_candle(c, count)
        if cfg.show and (cfg.ltf_sweeps or cfg.htf_sweeps)
            candles.detect_sweeps(is_new)
    candles
f_htf1_pair() =>
    tf_sec == 60 ? '15' : tf_sec == 180 ? '15' : tf_sec == 300 ? '60' : tf_sec == 900 ? '240' : tf_sec == 1800 ? '240' : tf_sec == 3600 ? TF_7H : ''
htf1_pair_tf = htf1_custom_pair ? f_htf1_pair() : ''
var string actual_tf_1 = htf_auto_1 ? (htf1_pair_tf != '' ? htf1_pair_tf : QTU.htfAutoTf(htf_auto_bucket_cur, 1, 'Classic Sequence')) : f_actual_tf(htf_sweeps_tf_1_custom_tf)
var string actual_tf_2 = TF_7H
var string actual_tf_3 = TF_1DP
perf_cisd_runtime_on = QTU.runtimeOn(perf_cisd_runtime_bars, max_calc_bars, bar_index, last_bar_index)
