f_sess_add_level(float _price, int _x1, bool _is_high, string _name, color _col) =>
    end_x = bar_index + sess_extend_bars
    new_line = line.new(x1 = _x1, y1 = _price, x2 = end_x, y2 = _price, xloc = xloc.bar_index, color = _col, style = line.style_solid, width = 1)
    new_label = label.new(x = end_x + 1, y = _price, text = _name, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.white, 100), textcolor = _col, size = sess_label_size)
    sess_levels.push(SessionLevel.new(price = _price, x1 = _x1, is_high = _is_high, name = _name, col = _col, ln = new_line, lb = new_label))
    while sess_levels.size() > 4
        old_level = sess_levels.shift()
        if not na(old_level.ln)
            line.delete(old_level.ln)
        if not na(old_level.lb)
            label.delete(old_level.lb)
    0
f_sess_clear_levels() =>
    while sess_levels.size() > 0
        old_level = sess_levels.pop()
        if not na(old_level.ln)
            line.delete(old_level.ln)
        if not na(old_level.lb)
            label.delete(old_level.lb)
    0
method track(SessionTrack this, bool _in_sess, string _name, color _col) =>
    if _in_sess
        if not this.active
            this.active := true
            this.hi := high
            this.lo := low
            this.hi_idx := bar_index
            this.lo_idx := bar_index
        else
            if high > this.hi
                this.hi := high
                this.hi_idx := bar_index
            if low < this.lo
                this.lo := low
                this.lo_idx := bar_index
    else if this.active
        this.active := false
        f_sess_add_level(this.hi, this.hi_idx, true, _name, _col)
        f_sess_add_level(this.lo, this.lo_idx, false, _name, _col)
    this
f_sess_update_levels() =>
    for lvl in sess_levels
        if not lvl.swept
            bool hit = false
            if lvl.is_high
                hit := sess_sweep_basis == 'Wick' ? high > lvl.price : close > lvl.price
            else
                hit := sess_sweep_basis == 'Wick' ? low < lvl.price : close < lvl.price
            if hit
                lvl.swept := true
                lvl.sweep_idx := bar_index
                line.set_x2(lvl.ln, bar_index)
                line.set_style(lvl.ln, line.style_dashed)
                label.set_xy(lvl.lb, lvl.x1, lvl.price)
                label.set_style(lvl.lb, lvl.is_high ? label.style_label_down : label.style_label_up)
            else if barstate.islast
                line.set_x2(lvl.ln, bar_index + sess_extend_bars)
                label.set_x(lvl.lb, bar_index + sess_extend_bars + 1)
    0

