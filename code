f_cisd_formation_index(string source_key, int pane, int owner) =>
    found_index = -1
    formation_count = cisd_formation_registry.size()
    if source_key != '' and formation_count > 0
        for formation_index = formation_count - 1 to 0
            formation = cisd_formation_registry.get(formation_index)
            if formation.source_key == source_key and formation.pane == pane and formation.owner == owner
                found_index := formation_index
                break
    found_index
f_cisd_ensure_formation(UDT_Sweep sweep, int pane, int tf_seconds, int owner, int direction) =>
    source_key = sweep.cisd_source_key == '' ? f_cisd_source_key(sweep.tf, sweep.x1, sweep.bull) : sweep.cisd_source_key
    formation_index = f_cisd_formation_index(source_key, pane, owner)
    if formation_index < 0
        cisd_formation_registry.push(CisdFormation.new(source_key = source_key, phase = CISD_PHASE_TRACKING, pane = pane, tf_sec = tf_seconds, owner = owner, dir = direction, source_x1 = sweep.x1, source_y = sweep.y))
