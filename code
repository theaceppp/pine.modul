f_sml_track(SmtLightTracker _t, array<UDT_HTF_Candle> _cs, float _o, float _h, float _l, float _c) =>
    if _cs.size() > 0 and not na(_h) and not na(_l)
        int cur_o = _cs.first().o_idx
        if na(_t.o_idx) or cur_o != _t.o_idx
            if not na(_t.o_idx)
                _t.prev_h := _t.h
                _t.prev_l := _t.l
                _t.prev_o := _t.o
                _t.prev_c := _t.c
            _t.h := _h
            _t.l := _l
            _t.o := _o
            _t.c := _c
            _t.o_idx := cur_o
        else
            _t.h := math.max(_t.h, _h)
            _t.l := math.min(_t.l, _l)
            _t.c := _c
    0
f_sml_hit(SmtLightTracker _t, bool _inverse, bool _bear) =>
    bool hit = false
    if not na(_t.prev_h) and not na(_t.prev_l) and not na(_t.h) and not na(_t.l)
        if _bear
            hit := _inverse ? _t.l > _t.prev_l : _t.h < _t.prev_h
        else
            hit := _inverse ? _t.h < _t.prev_h : _t.l > _t.prev_l
    hit
f_sml_set_mark(int _pane, int _dir, UDT_HTF_Candle _c1, UDT_HTF_Candle _c2, bool _hit_a, bool _hit_b, string _tf) =>
    bool sweeping = _dir == -1 ? _c2.h > _c1.h : _c2.l < _c1.l
    int found = -1
    for [i, mk] in sml_marks
        if mk.pane == _pane and mk.dir == _dir and mk.c2_o_idx == _c2.o_idx
            found := i
            break
    if sweeping and (_hit_a or _hit_b)
        string names = _hit_a and _hit_b ? smt_pair + '/' + smt_pair2 : _hit_a ? smt_pair : smt_pair2
        string txt = f_smt_label_text(_tf, names)
        int nx1 = _dir == -1 ? _c1.h_idx : _c1.l_idx
        float ny1 = _dir == -1 ? _c1.h : _c1.l
        int nx2 = _dir == -1 ? _c2.h_idx : _c2.l_idx
        float ny2 = _dir == -1 ? _c2.h : _c2.l
        if found >= 0
            SmtLiteMark cur_mark = sml_marks.get(found)
            cur_mark.x1 := nx1
            cur_mark.y1 := ny1
            cur_mark.x2 := nx2
            cur_mark.y2 := ny2
            cur_mark.lbl_text := txt
        else
            sml_marks.push(SmtLiteMark.new(pane = _pane, dir = _dir, c1_o_idx = _c1.o_idx, c2_o_idx = _c2.o_idx, x1 = nx1, y1 = ny1, x2 = nx2, y2 = ny2, lbl_text = txt))
            while sml_marks.size() > smt_history_limit
                sml_marks.shift()
    else if found >= 0
        sml_marks.remove(found)
    0
f_psp_eval(SmtLightTracker _t, UDT_HTF_Candle _closed, bool _inverse) =>
    bool hit = false
    if not na(_t.prev_o) and not na(_t.prev_c)
        float own_d = _closed.c - _closed.o
        float comp_d = _t.prev_c - _t.prev_o
        if own_d != 0 and comp_d != 0
            hit := _inverse ? own_d * comp_d > 0 : own_d * comp_d < 0
    hit
f_sml_pane(int _pane, array<UDT_HTF_Candle> _cs, SmtLightTracker _ta, SmtLightTracker _tb, float _ao, float _ah, float _al, float _ac, float _bo, float _bh, float _bl, float _bc, string _tf, string _raw_tf, bool _marks_on) =>
    if _cs.size() > 0
        f_sml_track(_ta, _cs, _ao, _ah, _al, _ac)
        f_sml_track(_tb, _cs, _bo, _bh, _bl, _bc)
    if psp_show and _cs.size() > 1
        UDT_HTF_Candle closed_c = _cs.get(1)
        if (na(_ta.psp_for) or closed_c.o_idx != _ta.psp_for) and not na(_ta.o_idx) and _ta.o_idx == _cs.first().o_idx
            bool psp_a = sml_en1 and f_psp_eval(_ta, closed_c, corr_inv1)
            bool psp_b = sml_en2 and f_psp_eval(_tb, closed_c, corr_inv2)
            if psp_a or psp_b
                psp_hits.push(PspHit.new(tf = _raw_tf, o_idx = closed_c.o_idx))
                while psp_hits.size() > 24
                    psp_hits.shift()
            _ta.psp_for := closed_c.o_idx
    if _marks_on and _cs.size() > 1
        UDT_HTF_Candle live_c = _cs.get(0)
        UDT_HTF_Candle prev_c = _cs.get(1)
        bool a_bear = sml_en1 and f_sml_hit(_ta, corr_inv1, true)
        bool b_bear = sml_en2 and f_sml_hit(_tb, corr_inv2, true)
        bool a_bull = sml_en1 and f_sml_hit(_ta, corr_inv1, false)
        bool b_bull = sml_en2 and f_sml_hit(_tb, corr_inv2, false)
        f_sml_set_mark(_pane, -1, prev_c, live_c, a_bear, b_bear, _tf)
        f_sml_set_mark(_pane, 1, prev_c, live_c, a_bull, b_bull, _tf)
    0

[sml_a_o, sml_a_h, sml_a_l, sml_a_c] = f_sml_fetch(csym, sml_en1)
[sml_b_o, sml_b_h, sml_b_l, sml_b_c] = f_sml_fetch(tsym3, sml_en2)
