prof_mod = hour(time, 'America/New_York') * 60 + minute(time, 'America/New_York')
prof_seg = (prof_mod >= 1080 or prof_mod < 60) ? 0 : prof_mod < 480 ? 1 : prof_mod < 900 ? 2 : 3
prof_new = prof_seg != nz(prof_seg[1], -1) or (time - nz(time[1], time)) > 12 * 60 * 60 * 1000
prof_target_min = prof_seg == 0 ? (prof_mod >= 1080 ? 1500 : 60) : prof_seg == 1 ? 480 : prof_seg == 2 ? 900 : 1080
